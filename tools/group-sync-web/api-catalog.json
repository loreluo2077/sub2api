{
  "catalog_version": 1,
  "base_path": "/api/v1",
  "auth_modes": {
    "public": "no credentials",
    "jwt": "Authorization: Bearer <access_token>",
    "api_key": "Authorization: Bearer <user_api_key>"
  },
  "recommended_collectors": [
    { "method": "GET", "path": "/health", "auth": "public", "resource": "health" },
    { "method": "GET", "path": "/api/v1/settings/public", "auth": "public", "resource": "settings" },
    { "method": "GET", "path": "/api/v1/auth/me", "auth": "jwt", "resource": "current_user" },
    { "method": "GET", "path": "/api/v1/user/profile", "auth": "jwt", "resource": "profile" },
    { "method": "GET", "path": "/api/v1/user/platform-quotas", "auth": "jwt", "resource": "platform_quotas" },
    { "method": "GET", "path": "/api/v1/user/aff", "auth": "jwt", "resource": "affiliate" },
    { "method": "GET", "path": "/api/v1/keys", "auth": "jwt", "resource": "api_keys", "paginated": true },
    { "method": "GET", "path": "/api/v1/groups/available", "auth": "jwt", "resource": "groups" },
    { "method": "GET", "path": "/api/v1/groups/rates", "auth": "jwt", "resource": "group_rates" },
    { "method": "GET", "path": "/api/v1/channels/available", "auth": "jwt", "resource": "channels", "optional_feature": true },
    { "method": "GET", "path": "/api/v1/model-plaza", "auth": "jwt_optional", "resource": "model_plaza", "optional_feature": true },
    { "method": "GET", "path": "/api/v1/usage/dashboard/snapshot-v2", "auth": "jwt", "resource": "usage_snapshot", "heavy": true },
    { "method": "GET", "path": "/api/v1/subscriptions/summary", "auth": "jwt", "resource": "subscription_summary" },
    { "method": "GET", "path": "/api/v1/subscriptions/progress", "auth": "jwt", "resource": "subscription_progress" },
    { "method": "GET", "path": "/api/v1/announcements", "auth": "jwt", "resource": "announcements" },
    { "method": "GET", "path": "/api/v1/redeem/history", "auth": "jwt", "resource": "redeem_history" },
    { "method": "GET", "path": "/api/v1/channel-monitors", "auth": "jwt", "resource": "channel_monitors", "optional_feature": true },
    { "method": "GET", "path": "/api/v1/payment/plans", "auth": "jwt", "resource": "payment_plans", "optional_feature": true },
    { "method": "GET", "path": "/api/v1/payment/orders/my", "auth": "jwt", "resource": "orders", "paginated": true, "optional_feature": true },
    { "method": "GET", "path": "/v1/sub2api/billing", "auth": "api_key", "resource": "key_billing" },
    { "method": "GET", "path": "/v1/models", "auth": "api_key", "resource": "models" },
    { "method": "GET", "path": "/v1/usage", "auth": "api_key", "resource": "key_usage" }
  ],
  "jwt_read_routes": [
    "GET /api/v1/auth/me",
    "GET /api/v1/user/profile",
    "GET /api/v1/user/aff",
    "GET /api/v1/user/platform-quotas",
    "GET /api/v1/user/api-keys/:id/usage/daily",
    "GET /api/v1/user/totp/status",
    "GET /api/v1/user/totp/verification-method",
    "GET /api/v1/user/passkeys",
    "GET /api/v1/pages/:slug",
    "GET /api/v1/keys",
    "GET /api/v1/keys/:id",
    "GET /api/v1/groups/available",
    "GET /api/v1/groups/rates",
    "GET /api/v1/channels/available",
    "GET /api/v1/model-plaza",
    "GET /api/v1/usage",
    "GET /api/v1/usage/:id",
    "GET /api/v1/usage/stats",
    "GET /api/v1/usage/errors",
    "GET /api/v1/usage/errors/:id",
    "GET /api/v1/usage/dashboard/stats",
    "GET /api/v1/usage/dashboard/trend",
    "GET /api/v1/usage/dashboard/models",
    "GET /api/v1/usage/dashboard/snapshot-v2",
    "POST /api/v1/usage/dashboard/api-keys-usage",
    "GET /api/v1/announcements",
    "GET /api/v1/redeem/history",
    "GET /api/v1/subscriptions",
    "GET /api/v1/subscriptions/active",
    "GET /api/v1/subscriptions/progress",
    "GET /api/v1/subscriptions/summary",
    "GET /api/v1/channel-monitors",
    "GET /api/v1/channel-monitors/:id/status",
    "GET /api/v1/payment/config",
    "GET /api/v1/payment/checkout-info",
    "GET /api/v1/payment/plans",
    "GET /api/v1/payment/limits",
    "GET /api/v1/payment/orders/my",
    "GET /api/v1/payment/orders/:id",
    "GET /api/v1/payment/orders/refund-eligible-providers"
  ],
  "notes": [
    "Admin routes under /api/v1/admin are intentionally excluded.",
    "Frontend references /api/v1/subscriptions/:id/progress, but the backend does not register it.",
    "Feature-gated endpoints can return an empty collection or 404.",
    "Panel routes are rate-limited; usage routes have stricter limits."
  ]
}
